
// ==================== 数据库备份 ====================

model DatabaseBackup {
  id           Int      @id @default(autoincrement())
  fileName     String   // 备份文件名
  fileSize     Int      // 文件大小（字节）
  remark       String?  // 备注
  status       String   @default("SUCCESS") // SUCCESS/FAILED
  errorMessage String?  // 错误信息
  createdAt    DateTime @default(now())
  
  @@index([createdAt])
}
